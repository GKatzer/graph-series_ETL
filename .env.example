# Graph Series ETL: copy to .env and fill in. .env is git-ignored; never commit it.
# Read by tmdb_fetcher.py, qdrant_loader.py, neo4j_loader.py and eval_retrieval.py (see README, "Configuration").

# TMDB v3 API key (free): https://www.themoviedb.org/settings/api
TMDB_API_KEY=CHANGE_ME

# Neo4j, Bolt address. Defaults when unset: bolt://localhost:7687, user neo4j, empty password.
NEO4J_URI=bolt://<neo4j-host>:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME

# Qdrant. QDRANT_PORT is the REST port; the loader talks gRPC on QDRANT_PORT + 1 (6334 for the default).
QDRANT_HOST=<qdrant-host>
QDRANT_PORT=6333
QDRANT_COLLECTION=graph-series
